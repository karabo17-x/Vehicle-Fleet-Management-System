# Copy to backend/.env and adjust for your environment.

AUTH_PUBLIC_KEY_PATH=../auth/keys/public.pem
# Use this instead of AUTH_PUBLIC_KEY_PATH if the auth service isn't on
# the same filesystem (e.g. separate containers without a shared volume):
# AUTH_PUBLIC_KEY_URL=http://localhost:8081/.well-known/public-key.pem
JWT_ALGORITHM=RS256
JWT_ISSUER=vfms-auth
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
EXPIRY_WARNING_DAYS=30